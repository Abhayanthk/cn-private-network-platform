# Shared settings: every Mac keeps an identical copy at ~/cn-team.env
# Fill in the IPs from the inventory table (docs/01-architecture.md) on the day you run the setup.
export TEAM=elu                    # lowercase letters/digits only → names are app.$TEAM.test, api.$TEAM.test
export MAC1_IP=CHANGE_ME           # Mac 1: DNS (dnsmasq)
export MAC2_IP=CHANGE_ME           # Mac 2: edge (nginx: TLS + load balancer)
export MAC3_IP=CHANGE_ME           # Mac 3: Backend A :3001
export MAC4_IP=CHANGE_ME           # Mac 4: Backend B :3002
export COLLEGE_DNS=8.8.8.8         # upstream DNS the Wi-Fi hands out (Mac 1 forwards non-project names here)
