
# Listen on localhost (Mac 1 itself) and the Wi-Fi IP (other Macs)
listen-address=127.0.0.1,10.7.16.231
bind-interfaces

# Don't read /etc/resolv.conf; forward normal names (google.com) upstream
no-resolv
server=8.8.8.8
server=1.1.1.1

# Our private zone: answer it ourselves, never forward it
local=/elu.test/
host-record=app.elu.test,10.7.7.100
host-record=api.elu.test,10.7.7.100

domain-needed
bogus-priv
log-queries
log-facility=/tmp/dnsmasq.log